{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lot du catalogue Échappées, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "articles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "location",
          "body",
          "image_url",
          "image_description",
          "image_caption",
          "image_credit",
          "image_license",
          "image_source_url",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "description": "Texte français de 100 à 150 mots, vérifié par le validateur Dart."
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "image_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "image_caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "image_credit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "image_license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "image_source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2000
                }
              }
            }
          },
          "published_at": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "source_published_at": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "event_date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
