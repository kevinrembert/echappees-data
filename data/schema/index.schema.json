{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Index du catalogue Échappées, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "batches"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "batches": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "url",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "URL relative au dossier du catalogue, ou HTTPS dans ce même dossier et sur la même origine ; sans query ni fragment."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      }
    }
  }
}
